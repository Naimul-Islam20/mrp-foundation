{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.7.1"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/public/assets/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_URL": "https://mrp-foundation.vercel.app",
        "APP_CONFIG_CACHE": "/tmp/storage/framework/config.php",
        "APP_EVENTS_CACHE": "/tmp/storage/framework/events.php",
        "APP_PACKAGES_CACHE": "/tmp/storage/framework/packages.php",
        "APP_ROUTES_CACHE": "/tmp/storage/framework/routes.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr"
    }
}
